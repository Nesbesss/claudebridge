# Anthropic-compatible shim server port
PORT=8787

# Your Zen (or router) API key used to reach MiniMax
ZEN_API_KEY=your_zen_api_key_here

# OpenAI-compatible base URL exposed by Zen/router
# Example: https://api.your-router.com
ZEN_BASE_URL=https://api.example.com

# Optional override if your provider uses a custom path
ZEN_CHAT_COMPLETIONS_PATH=/v1/chat/completions

# MiniMax model ID available on your provider
# Example candidates: minimax/minimax-2.5-chat, minimax-text-01
MINIMAX_MODEL=minimax/minimax-2.5-chat

# Optional: default temperature if caller does not pass one
DEFAULT_TEMPERATURE=0.2
